{
  "name": "@softwarity/nestjs-livewire",
  "version": "0.0.0",
  "description": "Live query synchronisation for NestJS: subscribe to a query over one WebSocket, get its answer and every answer after it.",
  "keywords": [
    "nestjs",
    "websocket",
    "live-query",
    "realtime",
    "subscription",
    "gateway",
    "virtual-scroll",
    "livewire"
  ],
  "homepage": "https://github.com/softwarity/livewire#readme",
  "bugs": {
    "url": "https://github.com/softwarity/livewire/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softwarity/livewire.git",
    "directory": "packages/nestjs"
  },
  "license": "Apache-2.0",
  "author": "François ACHACHE <francois.achache@gmail.com>",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@softwarity/livewire-protocol": "0.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0 <12.0.0",
    "@nestjs/core": ">=10.0.0 <12.0.0",
    "@nestjs/websockets": ">=10.0.0 <12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.5.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-ws": "^11.0.1",
    "@nestjs/testing": "^11.0.1",
    "@nestjs/websockets": "^11.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0",
    "ws": "^8.18.0",
    "@softwarity/livewire-mock": "0.0.0",
    "@nestjs/platform-express": "^11.0.1"
  }
}
