{
  "name": "@softwarity/livewire",
  "version": "0.1.0",
  "description": "Live query synchronisation for Angular: subscribe to a query over one WebSocket, get its answer and every answer after it. Virtual-scroll data source included.",
  "keywords": [
    "angular",
    "websocket",
    "live-query",
    "realtime",
    "signals",
    "virtual-scroll",
    "cdk",
    "livewire"
  ],
  "homepage": "https://github.com/softwarity/livewire#readme",
  "bugs": {
    "url": "https://github.com/softwarity/livewire/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softwarity/livewire.git",
    "directory": "packages/angular"
  },
  "license": "Apache-2.0",
  "author": "François ACHACHE <francois.achache@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && ng-packagr -p ng-package.json",
    "check": "tsc -p tsconfig.spec.json --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "@angular/cdk": ">=18.0.0",
    "@angular/common": ">=18.0.0",
    "@angular/core": ">=18.0.0",
    "rxjs": "^7.5.0"
  },
  "dependencies": {
    "@softwarity/livewire-protocol": "0.1.0",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular/cdk": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.4.2",
    "ng-packagr": "^19.0.0",
    "rxjs": "^7.8.1",
    "typescript": "~5.6.0",
    "zone.js": "^0.15.0",
    "@softwarity/livewire-mock": "0.1.0"
  }
}
