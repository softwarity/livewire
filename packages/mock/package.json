{
  "name": "@softwarity/livewire-mock",
  "version": "0.4.0",
  "description": "An in-memory Livewire server: the same protocol, no socket. For demos, for tests, and for a screen with no backend yet.",
  "keywords": [
    "livewire",
    "mock",
    "testing",
    "websocket",
    "live-query"
  ],
  "homepage": "https://github.com/softwarity/livewire#readme",
  "bugs": {
    "url": "https://github.com/softwarity/livewire/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softwarity/livewire.git",
    "directory": "packages/mock"
  },
  "license": "Apache-2.0",
  "author": "François ACHACHE <francois.achache@gmail.com>",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-dual.mjs packages/mock",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@softwarity/livewire-protocol": "0.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.13"
  },
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  }
}
